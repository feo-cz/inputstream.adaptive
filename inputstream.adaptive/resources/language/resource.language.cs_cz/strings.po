msgstr "640p"

#. Item list value of setting with label #30110, #30113, #30172
msgctxt "#30213"
msgid "720p"
msgstr "720p"

#. Item list value of setting with label #30110, #30113, #30172
msgctxt "#30214"
msgid "1080p"
msgstr "1080p"

#. Item list value of setting with label #30110, #30113, #30172
msgctxt "#30215"
msgid "2K"
msgstr "2K"

#. Item list value of setting with label #30110, #30113, #30172
msgctxt "#30216"
