msgctxt "Addon Summary"
msgid "InputStream client for adaptive streams"
msgstr "Klient InputStream pro adaptivní streamy"

msgctxt "Addon Description"
msgid "InputStream client for adaptive streams. Common streaming protocols such as MPEG-DASH, HLS and Microsoft Smooth Streaming are supported.[CR][CR]The add-on also has support for DRM protected streams, such as Google Widevine, Microsoft PlayReady and others.[CR][CR]For documentation visit: https://github.com/xbmc/inputstream.adaptive"
msgstr "Klient InputStream pro adaptivní streamy. Podporovány jsou běžné streamovací protokoly, jako jsou MPEG-DASH, HLS a Microsoft Smooth Streaming.[CR][CR]Doplněk podporuje také streamy chráněné pomocí DRM, například Google Widevine, Microsoft PlayReady a další.[CR][CR]Dokumentaci najdete na: https://github.com/xbmc/inputstream.adaptive"

#. Category title
msgctxt "#30100"
msgid "General"
msgstr "Obecné"

#. The minimum bandwidth which should not be deceeded
msgctxt "#30101"
msgid "Minimum bandwidth (Kbps)"
msgstr "Minimální datový tok (kb/s)"

#. The maximum bandwidth which should not be exceeded
msgctxt "#30102"
msgid "Maximum bandwidth (Kbps)"
msgstr "Maximální datový tok (kb/s)"

#. Description of setting with label #30101, 30102
msgctxt "#30103"
msgid "Establishes the bandwidth limit not to be exceeded with the audio / video streams. Set to 0 to disable it."
msgstr "Nastavuje limit datového toku pro audio/video streamy. Nastavením na 0 ho vypnete."

# empty strings from id 30104 to 30109
#. Maximum video resolution non-protected videos
msgctxt "#30110"
msgid "Maximum resolution"
msgstr "Maximální rozlišení"

# empty string with id 30111
#. Type of media streams that will be handled for the playback
msgctxt "#30112"
msgid "Type of media streams played"
msgstr "Typ přehrávaných mediálních streamů"

#. Maximum video resolution for DRM-protected videos
msgctxt "#30113"
msgid "Maximum resolution for DRM videos"
msgstr "Maximální rozlišení pro videa s DRM"

# empty string with id 30114
# Do not respect display resolution when selecting streams
msgctxt "#30115"
msgid "Ignore screen resolution"
msgstr "Ignorovat rozlišení obrazovky"

#. Description of setting with label #30115
msgctxt "#30116"
msgid "If enabled, the screen resolution (or window size when in windowed mode) will no longer be considered when selecting the best video stream resolution when video starts and while in playback."
msgstr "Pokud je povoleno, při výběru nejlepšího rozlišení video streamu při spuštění videa a během přehrávání se už nebude brát v úvahu rozlišení obrazovky (nebo velikost okna v režimu okna)."

msgctxt "#30117"
msgid "Manual stream selection mode"
msgstr "Režim ručního výběru streamu"

#. Description of setting with label #30117
msgctxt "#30118"
msgid "Defines which type of streams to make available for manual selection on Kodi OSD settings during playback."
msgstr "Určuje, které typy streamů budou během přehrávání dostupné pro ruční výběr v nastavení OSD Kodi."

#. Category title
msgctxt "#30120"
msgid "Expert"
msgstr "Expert"

# empty string with id 30121
msgctxt "#30122"
msgid "Disable secure decoder"
msgstr "Zakázat zabezpečený dekodér"

#. Description of setting with label #30122
msgctxt "#30123"
msgid "Some Android devices defined as Widevine L1, may not work properly, which may result in a black screen during playback. In this case try to enable it. This setting may be overridden by the video add-on used."
msgstr "Některá zařízení Android označená jako Widevine L1 nemusí fungovat správně, což může během přehrávání způsobit černou obrazovku. V takovém případě zkuste tuto volbu zapnout. Toto nastavení může být přepsáno použitým video doplňkem."

# empty strings from id 30124 to 30155
#. Item list value of setting with label #30117
msgctxt "#30156"
msgid "Audio / Video streams"
msgstr "Audio/video streamy"

#. Item list value of setting with label #30112
msgctxt "#30157"
msgid "All"
msgstr "Vše"

#. Item list value of setting with label #30112
msgctxt "#30158"
msgid "Audio"
msgstr "Zvuk"

#. Item list value of setting with label #30112
msgctxt "#30159"
msgid "Video"
msgstr "Video"

#. Item list value of setting with label #30117
msgctxt "#30160"
msgid "Video streams"
msgstr "Video streamy"

#. Item list value of setting with label #30112
msgctxt "#30161"
msgid "Video / Subtitles"
msgstr "Video / titulky"

#. Category group title
msgctxt "#30162"
msgid "Adaptive stream"
msgstr "Adaptivní stream"

# empty strings from id 30163 to 30165
#. Category group title
msgctxt "#30166"
msgid "DRM Widevine"
msgstr "DRM Widevine"

msgctxt "#30167"
msgid "WARNING: This is a TEST feature, may not work appropriately and may change on future versions."
msgstr "UPOZORNĚNÍ: Toto je TESTOVACÍ funkce, nemusí fungovat správně a v budoucích verzích se může změnit."

msgctxt "#30168"
msgid "Auto determines initial bandwidth"
msgstr "Automaticky určovat počáteční datový tok"

#. Description of setting with label #30168
msgctxt "#30169"
msgid "If enabled, the bandwidth will be determined by the first download, however it may not be accurate. If the video quality at the start of playback is too low try disabling it."
msgstr "Pokud je povoleno, datový tok se určí podle prvního stažení, nemusí však být přesný. Pokud je kvalita videa na začátku přehrávání příliš nízká, zkuste tuto volbu vypnout."

msgctxt "#30170"
msgid "Initial bandwidth (Kbps)"
msgstr "Počáteční datový tok (kb/s)"

#. Description of setting with label #30170
msgctxt "#30171"
msgid "Defines the initial bandwidth when it cannot be automatically determined. This value can be overridden by the minimum bandwidth setting."
msgstr "Určuje počáteční datový tok v případě, že ho nelze zjistit automaticky. Tato hodnota může být přepsána nastavením minimálního datového toku."

msgctxt "#30172"
msgid "Resolution limit"
msgstr "Limit rozlišení"

#. Description of setting with label #30172
msgctxt "#30173"
msgid "If set, based on the capabilities of the video stream an attempt will be made to limit the range of resolutions to the one chosen."
msgstr "Pokud je nastaveno, doplněk se na základě možností video streamu pokusí omezit rozsah rozlišení na vybrané rozlišení."

#. To set the stream selection type (refer to RepresentationChooser's)
msgctxt "#30174"
msgid "Stream selection type"
msgstr "Typ výběru streamu"

#. Description of setting with label #30174
msgctxt "#30175"
msgid "Set how the audio / video streams quality will be chosen during playback. This setting may be overridden by the video add-on used. See Wiki for more information."
msgstr "Nastavuje, jak se bude během přehrávání vybírat kvalita audio/video streamů. Toto nastavení může být přepsáno použitým video doplňkem. Další informace najdete na wiki."

#. Item list value of setting with label #30174
msgctxt "#30176"
msgid "Adaptive (default)"
msgstr "Adaptivní (výchozí)"

#. Item list value of setting with label #30174
msgctxt "#30177"
msgid "Manual OSD"
msgstr "Ručně v OSD"

#. Item list value of setting with label #30174
msgctxt "#30178"
msgid "Fixed resolution"
msgstr "Pevné rozlišení"

#. Item list value of setting with label #30174
msgctxt "#30179"
msgid "Ask quality"
msgstr "Zeptat se na kvalitu"

#. Item list value of setting with label #30174
msgctxt "#30180"
msgid "Test"
msgstr "Test"

# empty strings reserved for "stream selection types" from id 30181 to 30190
#. Assured buffer length duration (seconds)
msgctxt "#30200"
msgid "Assured buffer duration (sec)"
msgstr "Zaručená délka bufferu (s)"

#. Max buffer length duration (seconds)
msgctxt "#30201"
msgid "Maximum buffer duration (sec)"
msgstr "Maximální délka bufferu (s)"

#. Ignore screen resolution change e.g. window resize
msgctxt "#30202"
msgid "Ignore screen resolution change"
msgstr "Ignorovat změnu rozlišení obrazovky"

#. Description of setting with label #30202
msgctxt "#30203"
msgid "If enabled, the screen resolution (or window size when in windowed mode) will no longer be considered when selecting the best video stream resolution while in playback."
msgstr "Pokud je povoleno, při výběru nejlepšího rozlišení video streamu během přehrávání se už nebude brát v úvahu rozlišení obrazovky (nebo velikost okna v režimu okna)."

#. Absolute path to the folder containing the DRM binary files
msgctxt "#30204"
msgid "Decrypter path"
msgstr "Cesta k dešifrovači"

# empty strings from id 30205 to 30208
#. Item list value of setting with label #30172
msgctxt "#30209"
msgid "Disabled"
msgstr "Vypnuto"

# empty strings from id 30205 to 30209
#. Item list value of setting with label #30110, #30113
msgctxt "#30210"
msgid "Auto"
msgstr "Automaticky"

#. Item list value of setting with label #30110, #30113, #30172
msgctxt "#30211"
msgid "480p"
msgstr "480p"

#. Item list value of setting with label #30110, #30113, #30172
msgctxt "#30212"
