#. Dialog window to select the video stream
msgctxt "#30231"
msgid "Select video stream"
msgstr "Vyberte video stream"

#. Description of each list item in #30231 dialog window
#. Do not translate placeholders: {codec} {quality} {hdr-type}
#. Use of double graphes e.g. {whatyouwant{hdr-type}whatyouwant} allows you to add additional text printed only when a value is present
msgctxt "#30232"
msgid "Video stream {codec}{ [{hdr-type}]} {quality}"
msgstr "Video stream {codec}{ [{hdr-type}]} {quality}"

#. Enum setting to set the test mode
msgctxt "#30233"
msgid "Test mode"
msgstr "Testovací režim"

#. Item list value of setting with label #30233
msgctxt "#30234"
msgid "Switch by segments"
msgstr "Přepínat po segmentech"

#. Stand for video stream segments, referred to setting with label #30234
msgctxt "#30235"
msgid "Video segments (set 0 to disable)"
msgstr "Video segmenty (0 = vypnuto)"

#. Category group title
msgctxt "#30236"
msgid "Override settings"
msgstr "Přepsání nastavení"

#. Category group title for debug settings
msgctxt "#30237"
msgid "Debug logging"
msgstr "Ladicí protokolování"

#. Debug setting to save stream manifests
msgctxt "#30238"
msgid "Save stream manifests"
msgstr "Ukládat manifesty streamů"

#. Description of setting with label #30238
msgctxt "#30239"
msgid "Saves stream manifests downloaded during playback in the user data folder of InputStream Adaptive."
msgstr "Ukládá manifesty streamů stažené během přehrávání do složky uživatelských dat doplňku InputStream Adaptive."

#. Debug setting to save license data
msgctxt "#30240"
msgid "Save license data"
msgstr "Ukládat licenční data"

#. Description of setting with label #30240
msgctxt "#30241"
msgid "Saves the license data for example: initial data, challenge data and response data, in the \"cdm\" folder of the Kodi data folder."
msgstr "Ukládá licenční data, například počáteční data, data výzvy a data odpovědi, do složky \"cdm\" ve složce dat Kodi."

#. Setting to enable verbose debug
msgctxt "#30242"
msgid "Enable verbose debug"
msgstr "Povolit podrobné ladění"

#. Description of setting with label #30242
msgctxt "#30243"
msgid "Verbose debugging can be useful for debugging components, but in some cases it may expose sensitive information in the log."
msgstr "Podrobné ladění může být užitečné při ladění komponent, ale v některých případech může v protokolu odhalit citlivé informace."

# empty strings reserved for settings from id 30244 to 30299
#. A GUI window title, "InputStream Adaptive" its the add-on name, not to be translated
msgctxt "#30300"
msgid "InputStream Adaptive error"
msgstr "Chyba InputStream Adaptive"

#. A GUI message that is displayed when there is a problem playing a stream
#. Do not translate placeholders: {error-details}
#. Use of double graphes e.g. {whatyouwant{error-details}whatyouwant} allows you to add additional text printed only when a value is present
msgctxt "#30301"
msgid "Unable to play the stream.{[CR]Error: {error-details}}"
msgstr "Stream nelze přehrát.{[CR]Chyba: {error-details}}"

msgctxt "#30302"
msgid "The decryptor path is not set in the add-on settings."
msgstr "Cesta k dešifrovači není v nastavení doplňku nastavena."

msgctxt "#30303"
msgid "A problem occurred with the DRM decryptor."
msgstr "Došlo k problému s dešifrovačem DRM."

msgctxt "#30304"
msgid "Cannot load Widevine CDM library."
msgstr "Knihovnu Widevine CDM nelze načíst."

msgctxt "#30305"
msgid "Cannot initialize Widevine CDM library."
msgstr "Knihovnu Widevine CDM nelze inicializovat."

msgctxt "#30306"
msgid "The configuration to play the stream is incomplete or missing."
msgstr "Konfigurace pro přehrání streamu je neúplná nebo chybí."

msgctxt "#30307"
msgid "Cannot download the stream manifest file."
msgstr "Soubor manifestu streamu nelze stáhnout."

msgctxt "#30308"
msgid "A problem occurred in the stream initialization."
msgstr "Došlo k problému při inicializaci streamu."

msgctxt "#30309"
msgid "No audio/video stream can be played."
msgstr "Nelze přehrát žádný audio/video stream."

